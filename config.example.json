{
  "$schemaVersion": 1,
  "settings": {
    "projectsRoot": "",
    "dashboardPort": 7777,
    "portRange": {
      "start": 4000,
      "end": 4099
    },
    "ringBytes": 262144,
    "metricsTtlSec": 60,
    "autoScan": true,
    "scanDepth": 1,
    "readyRegex": "ready in|listening on|Local:\\s+http|started server|compiled|running at",
    "editorCommand": "code"
  },
  "projects": {
    "my-app": {
      "port": 4000,
      "name": "My App",
      "command": "npm run dev",
      "portFlag": "--port",
      "portEnv": "PORT",
      "env": {
        "SOME_VAR": "value"
      },
      "hidden": false,
      "registry": {
        "kind": "npm",
        "name": "my-app"
      }
    }
  },
  "profiles": {
    "stack": [
      "api",
      "web"
    ]
  }
}
