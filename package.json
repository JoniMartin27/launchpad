{
  "name": "@fervon/launchpad",
  "version": "1.1.0",
  "type": "module",
  "description": "Local-first dashboard to discover, launch and monitor every dev project in a folder — auto-detected, no port clashes, live logs. Binds 127.0.0.1 only.",
  "keywords": [
    "dashboard",
    "developer-tools",
    "dev-server",
    "local-first",
    "localhost",
    "monorepo",
    "port",
    "process-manager",
    "project-launcher",
    "self-hosted"
  ],
  "homepage": "https://github.com/JoniMartin27/launchpad#readme",
  "bugs": "https://github.com/JoniMartin27/launchpad/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoniMartin27/launchpad.git"
  },
  "license": "MIT",
  "author": "Jonathan Martín (https://fervon.dev)",
  "bin": {
    "launchpad": "bin/launchpad.js"
  },
  "files": [
    "bin/",
    "server/src/",
    "web/dist/",
    "config.example.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w web run dev",
    "start": "npm -w server run start",
    "build": "npm -w web run build",
    "serve": "npm -w server run start",
    "test": "npm -w server test",
    "prepublishOnly": "npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.11.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
